<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <LangVersion>latest</LangVersion>

    <!-- NativeAOT 设置（仅 publish 时生效；dotnet build 不受影响） -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <TrimMode>full</TrimMode>

    <!-- 应用图标（楷体「画」字，由 tools/icongen 生成） -->
    <ApplicationIcon>Assets\yuehua.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 供窗口标题栏使用的图标资源（avares://Yuehua/Assets/yuehua.png） -->
    <AvaloniaResource Include="Assets\yuehua.png" />
    <AvaloniaResource Include="Assets\yuehua.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       图标库：统一 24×24 视口、描边风格（Stroke + 圆头圆角）。
       几何取自业界通用形状（Feather / Lucide 一脉），保证一眼可辨。
       ============================================================ -->

  <!-- ============ 文件 / 导航 ============ -->
  <!-- 打开图片：相框 + 日/山 -->
  <StreamGeometry x:Key="ic_open">M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13A2.5 2.5 0 0 1 18.5 21h-13A2.5 2.5 0 0 1 3 18.5v-13Z M8.8 9.6a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0-2.6 0 M3.4 16.2 L8.3 11.6 L11.4 14.6 L15.6 9.9 L20.6 15.6</StreamGeometry>
  <!-- 打开文件夹 -->
  <StreamGeometry x:Key="ic_folder">M3 6.8a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.6.8l1.2 1.6H19a2 2 0 0 1 2 2v8.8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6.8Z</StreamGeometry>
  <!-- 上一张（chevron 左） -->
  <StreamGeometry x:Key="ic_prev">M14.5 5.5 L8 12 L14.5 18.5</StreamGeometry>
  <!-- 下一张（chevron 右） -->
  <StreamGeometry x:Key="ic_next">M9.5 5.5 L16 12 L9.5 18.5</StreamGeometry>

  <!-- ============ 缩放：标准放大镜 ============ -->
  <!-- 缩小：放大镜内含「−」 -->
  <StreamGeometry x:Key="ic_zoom_out">M10.5 4a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13 M15.4 15.4 L20.2 20.2 M7.8 10.5 L13.2 10.5</StreamGeometry>
  <!-- 放大：放大镜内含「＋」 -->
  <StreamGeometry x:Key="ic_zoom_in">M10.5 4a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13 M15.4 15.4 L20.2 20.2 M7.8 10.5 L13.2 10.5 M10.5 7.8 L10.5 13.2</StreamGeometry>
  <!-- 适应窗口：四角外扩 -->
  <StreamGeometry x:Key="ic_fit">M8.5 3.5H5.5A2 2 0 0 0 3.5 5.5V8.5 M15.5 3.5h3a2 2 0 0 1 2 2V8.5 M20.5 15.5v3a2 2 0 0 1-2 2h-3 M8.5 20.5H5.5a2 2 0 0 1-2-2V15.5</StreamGeometry>
  <!-- 原始像素 1:1 -->
  <StreamGeometry x:Key="ic_actual">M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8 M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8 M20 16v2.5A1.5 1.5 0 0 1 18.5 20H16 M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16 M8.5 12 L10 12 M13.4 9.6 V14.4 M15.4 12 L17 12</StreamGeometry>

  <!-- ============ 旋转：标准「弧线 + 折角箭头」 ============ -->
  <!-- 逆时针 90° -->
  <StreamGeometry x:Key="ic_rot_l">M3.5 5.5 L3.5 11 L9 11 M4.02 15.2 A8 8 0 1 0 6.13 6.13 L3.5 11</StreamGeometry>
  <!-- 顺时针 90° -->
  <StreamGeometry x:Key="ic_rot_r">M20.5 5.5 L20.5 11 L15 11 M19.98 15.2 A8 8 0 1 1 17.87 6.13 L20.5 11</StreamGeometry>

  <!-- ============ 翻转：中轴 + 双侧三角 ============ -->
  <!-- 水平翻转 -->
  <StreamGeometry x:Key="ic_flip_h">M12 3.5 L12 20.5 M7.5 7 L3 12 L7.5 17 M16.5 7 L21 12 L16.5 17</StreamGeometry>
  <!-- 垂直翻转 -->
  <StreamGeometry x:Key="ic_flip_v">M3.5 12 L20.5 12 M7 7.5 L12 3 L17 7.5 M7 16.5 L12 21 L17 16.5</StreamGeometry>

  <!-- ============ 撤销 / 重做：标准 U 形回转箭头 ============ -->
  <StreamGeometry x:Key="ic_undo">M9.5 14.5 L4 9 L9.5 3.5 M4 9h10.6A5.5 5.5 0 0 1 20.1 14.5v0A5.5 5.5 0 0 1 14.6 20H11</StreamGeometry>
  <StreamGeometry x:Key="ic_redo">M14.5 14.5 L20 9 L14.5 3.5 M20 9H9.4A5.5 5.5 0 0 0 3.9 14.5v0A5.5 5.5 0 0 0 9.4 20H13</StreamGeometry>

  <!-- ============ 输出 / 模式 ============ -->
  <!-- 导出（下载到托盘） -->
  <StreamGeometry x:Key="ic_export">M20.5 14.5V18a2.5 2.5 0 0 1-2.5 2.5H6A2.5 2.5 0 0 1 3.5 18V14.5 M7.5 10.5 L12 15 L16.5 10.5 M12 15V3.5</StreamGeometry>
  <!-- 专注模式（四角内收） -->
  <StreamGeometry x:Key="ic_focus">M4.5 8.5H3.5A2 2 0 0 1 3.5 4.5H8.5 M15.5 4.5h4a2 2 0 0 1 0 4H15.5 M19.5 15.5h0a2 2 0 0 1 0 4H15.5 M8.5 19.5H3.5a2 2 0 0 1 0-4H4.5</StreamGeometry>
  <!-- 进入 / 退出标注（铅笔） -->
  <StreamGeometry x:Key="ic_annotate">M16.9 3.6a2.75 2.75 0 0 1 3.9 3.9L8.2 19.1 2.8 20.6 4.3 15.2Z M15.4 5.1 L18.3 8</StreamGeometry>
  <!-- 设置（滑块） -->
  <StreamGeometry x:Key="ic_settings">M3.5 8 L20.5 8 M3.5 16 L20.5 16 M6.6 8 A2.4 2.4 0 1 0 11.4 8 A2.4 2.4 0 1 0 6.6 8 M12.6 16 A2.4 2.4 0 1 0 17.4 16 A2.4 2.4 0 1 0 12.6 16</StreamGeometry>

  <!-- ============ 面板 / 主题 ============ -->
  <StreamGeometry x:Key="ic_moon">M21 12.79 A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79 Z</StreamGeometry>
  <StreamGeometry x:Key="ic_sun">M12 7.5 A4.5 4.5 0 1 0 12 16.5 A4.5 4.5 0 1 0 12 7.5 Z M12 2 L12 4 M12 20 L12 22 M2 12 L4 12 M20 12 L22 12 M4.9 4.9 L6.3 6.3 M17.7 17.7 L19.1 19.1 M19.1 4.9 L17.7 6.3 M6.3 17.7 L4.9 19.1</StreamGeometry>
  <StreamGeometry x:Key="ic_panel">M3.5 5 L20.5 5 L20.5 19 L3.5 19 Z M15 5 L15 19</StreamGeometry>
  <StreamGeometry x:Key="ic_thumbs">M3.5 5 L20.5 5 L20.5 19 L3.5 19 Z M3.5 15 L20.5 15</StreamGeometry>

  <!-- ============ 标注工具 ============ -->
  <StreamGeometry x:Key="ic_cursor">M6 3 L6 17.6 L9.4 14.3 L11.9 19.9 L14.3 18.9 L11.9 13.7 L16.6 13.5 Z</StreamGeometry>
  <StreamGeometry x:Key="ic_rect">M4.5 5.5 L19.5 5.5 L19.5 18.5 L4.5 18.5 Z</StreamGeometry>
  <StreamGeometry x:Key="ic_ellipse">M4.5 12 A7.5 6.5 0 1 0 19.5 12 A7.5 6.5 0 1 0 4.5 12 Z</StreamGeometry>
  <StreamGeometry x:Key="ic_line">M4.5 19.5 L19.5 4.5</StreamGeometry>
  <StreamGeometry x:Key="ic_arrow">M4.5 19.5 L19 5 M12.5 5 L19 5 L19 11.5</StreamGeometry>
  <StreamGeometry x:Key="ic_text">M5 5 L19 5 M12 5 L12 19 M9 19 L15 19</StreamGeometry>
  <!-- 画笔：标准铅笔 -->
  <StreamGeometry x:Key="ic_pen">M16.9 3.6a2.75 2.75 0 0 1 3.9 3.9L8.2 19.1 2.8 20.6 4.3 15.2Z M15.4 5.1 L18.3 8</StreamGeometry>
  <!-- 马赛克：3×3 网格 -->
  <StreamGeometry x:Key="ic_mosaic">M3.5 3.5 L20.5 3.5 L20.5 20.5 L3.5 20.5 Z M9.17 3.5 L9.17 20.5 M14.83 3.5 L14.83 20.5 M3.5 9.17 L20.5 9.17 M3.5 14.83 L20.5 14.83</StreamGeometry>
  <!-- 模糊：三段递散横线（散焦感） -->
  <StreamGeometry x:Key="ic_blur">M3.5 7.5 L20.5 7.5 M6 12 L18 12 M4.5 16.5 L19.5 16.5</StreamGeometry>

  <!-- ============ 图层 / 杂项 ============ -->
  <StreamGeometry x:Key="ic_eye">M2 12 C5.5 6.4 9 5 12 5 C15 5 18.5 6.4 22 12 C18.5 17.6 15 19 12 19 C9 19 5.5 17.6 2 12 Z M12 8.5 A3.5 3.5 0 1 0 12 15.5 A3.5 3.5 0 1 0 12 8.5 Z</StreamGeometry>
  <StreamGeometry x:Key="ic_eye_off">M3 3 L21 21 M10.3 6 A9.4 9.4 0 0 1 12 5.9 C15 5.9 18.5 7.3 22 12.9 C20.6 15.4 19 17.2 17.1 18.4 M6.4 7.7 C4 9.2 2.5 10.9 2 12.9 C4.4 16.8 7 18.5 9.6 19 M10.2 10.5 A3.5 3.5 0 0 0 13.7 13.9</StreamGeometry>
  <!-- 烙印：图章 -->
  <StreamGeometry x:Key="ic_stamp">M6.5 6.5 L17.5 6.5 M12 6.5 L12 16.5 M12 16.5 L8.2 12.7 M12 16.5 L15.8 12.7 M4 20.5 L20 20.5</StreamGeometry>
  <StreamGeometry x:Key="ic_trash">M4.5 7 L19.5 7 M9.5 7 L9.5 4.5 L14.5 4.5 L14.5 7 M6.5 7 L7.6 20 L16.4 20 L17.5 7</StreamGeometry>
  <StreamGeometry x:Key="ic_add">M12 6 L12 18 M6 12 L18 12</StreamGeometry>
  <StreamGeometry x:Key="ic_check">M5 12.5 L10 17.5 L19 6.5</StreamGeometry>

  <!-- ============ 窗口控制 ============ -->
  <StreamGeometry x:Key="ic_minimize">M5 10 L19 10 L19 14 L5 14 Z</StreamGeometry>
  <StreamGeometry x:Key="ic_maximize">M5.5 5.5 L18.5 5.5 L18.5 18.5 L5.5 18.5 Z</StreamGeometry>
  <StreamGeometry x:Key="ic_restore">M8.5 5.5 L18.5 5.5 L18.5 15.5 L8.5 15.5 Z M5.5 8.5 L15.5 8.5 L15.5 18.5 L5.5 18.5 Z M8.5 5.5 L8.5 8.5 M18.5 15.5 L18.5 18.5</StreamGeometry>
  <StreamGeometry x:Key="ic_close">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
</ResourceDictionary>
